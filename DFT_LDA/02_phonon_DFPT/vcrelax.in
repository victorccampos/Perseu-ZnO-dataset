&CONTROL
calculation = 'vc-relax'
prefix = 'ZnO_vcrelax_LDA', outdir = './'
pseudo_dir = '/home/jvc/LDA_Study/pseudos/pseudo_dojo'
nstep = 300
! -- Imprime forças e stress -- !
tstress = .true.
tprnfor = .true.
! -- Critérios da otimização -- !
etot_conv_thr = 1.0d-8
forc_conv_thr = 1.0d-4
! ----------- I/O --------------!
verbosity = 'high' 
disk_io = 'none'
/
&SYSTEM
    ibrav= 4
    celldm(1) = 6.1600 
    celldm(3) = 1.5999 
    ntyp= 2
    nat=  4
    ecutwfc =  80
    ecutrho = 320
    occupations = 'fixed'
    nbnd =  36
/
&ELECTRONS
    diagonalization = 'david'
    mixing_mode='local-TF'
    conv_thr = 1.0d-12
    mixing_beta = 0.3
    electron_maxstep = 120
/
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press_conv_thr  = 0.5d0 ! Unidade KBar
  cell_dofree='ibrav'
/
ATOMIC_SPECIES
Zn   65.380    Zn_pseudo-dojo_NC_SR_LDA.upf
 O   15.999    O_pseudo-dojo_NC_SR_LDA.upf

K_POINTS automatic
6 6 4  0  0  0

ATOMIC_POSITIONS (crystal)
Zn   0.3333333333   0.6666666667   0.0000000000
Zn   0.6666666667   0.3333333333   0.5000000000
O    0.3333333333   0.6666666667   0.3800000000  ! u parameter aprox 0.38
O    0.6666666667   0.3333333333   0.8800000000
