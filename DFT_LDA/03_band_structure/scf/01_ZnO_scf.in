&CONTROL
   ! self-consistent calcultation using LDA optimized structure obtained via
   ! script scf_from_vcrelax.py
   calculation      = 'scf'
   verbosity        = 'high'
   tprnfor          = .true.
   prefix           = 'ZnO_LDA_noU'
   outdir	    = '../tmp_qe/'
   pseudo_dir       = '/home/jvc/LDA_Study/pseudos/pseudo_dojo'
/
&SYSTEM
   ecutwfc          = 80
   ecutrho          = 320
   occupations      = 'fixed'
   ntyp             = 2
   nat              = 4
   ibrav            = 0
   nbnd		    = 36
/
&ELECTRONS
   conv_thr         = 1e-08
   mixing_beta      = 0.3
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Zn 65.38 Zn_pseudo-dojo_NC_SR_LDA.upf
O 15.999 O_pseudo-dojo_NC_SR_LDA.upf

K_POINTS automatic
6 6 4  0 0 0

CELL_PARAMETERS angstrom
3.19617831144563 0.00000000000000 0.00000000000000
-1.59808915572282 2.76797161332331 0.00000000000000
0.00000000000000 0.00000000000000 5.13145971096848

ATOMIC_POSITIONS crystal
Zn 0.3333333333 0.6666666667 -0.0001559752  
Zn 0.6666666667 0.3333333333 0.4998440248  
O 0.3333333333 0.6666666667 0.3801559752  
O 0.6666666667 0.3333333333 0.8801559752  

