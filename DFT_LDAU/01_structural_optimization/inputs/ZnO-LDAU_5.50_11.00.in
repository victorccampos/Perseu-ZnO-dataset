&CONTROL
  calculation = 'vc-relax',
  restart_mode = 'from_scratch',
  !restart_mode = 'restart',
  pseudo_dir = '/home/jvc/LDA_Study/pseudos/pseudo_dojo',
  outdir='.'
  prefix = 'ZnO_LDA_U',
  disk_io = 'none'
  nstep=300,
  verbosity = 'high',
  tstress=.true.,
  tprnfor=.true.,
  forc_conv_thr=1.0d-5,
  etot_conv_thr=1.0d-6,
/
&SYSTEM
    ibrav= 4,
    celldm(1) = 6.1999, 
    celldm(3) = 1.5999 
    ntyp= 2,
    nat=  4,
    ecutwfc =  80,
    ecutrho = 320,
    occupations = 'fixed',
    nbnd =  36,
    degauss = 0.005,
/
&ELECTRONS
    diagonalization = 'david'
    mixing_mode='local-TF',
    conv_thr= 1.0d-8,
    mixing_beta=0.1,
    electron_maxstep=190,
/
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
  press_conv_thr  = 0.5d0 ! Unidade KBar
  cell_dofree='ibrav'
/
ATOMIC_SPECIES
Zn   65.380    Zn_pseudo-dojo_NC_SR_LDA.upf
 O   15.999    O_pseudo-dojo_NC_SR_LDA.upf

K_POINTS automatic
6 6 4  0  0  0

ATOMIC_POSITIONS (crystal)
Zn   0.3333333333   0.6666666667   0.0000000000
Zn   0.6666666667   0.3333333333   0.5000000000
O    0.3333333333   0.6666666667   0.3800000000  ! u parameter aprox 0.38
O    0.6666666667   0.3333333333   0.8800000000

! Von Braun starting positions (swap Zn1 => Zn2, O1 => O2)
! Zn   0.6666666666666661    0.3333333333333330    0.5005917000000000
! Zn   0.3333333333333330    0.6666666666666661    0.0005916999999990
!  O   0.6666666666666661    0.3333333333333330    0.8797183000000000
!  O   0.3333333333333330    0.6666666666666661    0.3797182999999990

HUBBARD (atomic)
U Zn-3d 5.50
U O-2p 11.00
