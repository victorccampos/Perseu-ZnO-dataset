Phonon dispersion curve with LDA+U. Ud = 12 eV Up = 7.0
&INPUTPH
  prefix = 'ZnO_scf' ! Prefix of files saved by program pw.x
  outdir = './out'
  epsil = .true. ! automatically deactivated when ldisp = .true.
  verbosity = 'high'
  tr2_ph = 1d-14 ! Threshold for self-consistency
  ldisp = .true. ! Cria automaticamente a lista de q-points numa malha uniforme.
  nq1 = 6
  nq2 = 6
  nq3 = 4
  fildyn = 'ZnO_matrizdinamicaPDC.dyn'
/

