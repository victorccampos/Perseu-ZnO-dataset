&CONTROL
   ! Non self-consistent calcultation using PBE optimized structure obtained via
   ! script scf_from_vcrelax.py
   calculation      = 'nscf'
   outdir	    = '../temp-qe/'
   verbosity        = 'high'
   tprnfor          = .true.
   prefix           = 'ZnO_PBE'
   pseudo_dir       = '/home/jvc/ZnO_database/pseudos/ppdojo_PBE'
/
&SYSTEM
   ecutwfc          = 80
   ecutrho          = 320
   occupations      = 'fixed'
   ntyp             = 2
   nat              = 4
   ibrav            = 0
   nbnd		    = 36
/
&ELECTRONS
   conv_thr         = 1e-08
   mixing_beta      = 0.3
/
ATOMIC_SPECIES
Zn 65.38 Zn_ppdojo_SR_NC_PBE.upf
O 15.999 O_ppdojo_SR_NC_PBE.upf

ATOMIC_POSITIONS crystal
Zn 0.3333333333 0.6666666667 -0.0001356709  
Zn 0.6666666667 0.3333333333 0.4998643291  
O 0.3333333333 0.6666666667 0.3801356709  
O 0.6666666667 0.3333333333 0.8801356709  

CELL_PARAMETERS angstrom
3.28116607976320 0.00000000000000 0.00000000000000
-1.64058303824118 2.84157317918099 0.00000000000000
0.00000000000000 0.00000000000000 5.27406409644231

K_POINTS (automatic)
12 12 10 0 0 0
