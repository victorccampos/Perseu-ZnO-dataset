&CONTROL
   ! Non self-consistent calcultation using PBE optimized structure obtained via
   ! script scf_from_vcrelax.py
   calculation      = 'bands'
   outdir	    = '../tmp_qe/'
   verbosity        = 'high'
   tprnfor          = .true.
   prefix           = 'ZnO_PBEU'
   pseudo_dir       = '/home/jvc/ZnO_database/pseudos/ppdojo_PBE'
/
&SYSTEM
   ecutwfc          = 80
   ecutrho          = 320
   occupations      = 'fixed'
   ntyp             = 2
   nat              = 4
   ibrav            = 0
   nbnd		        = 36
/
&ELECTRONS
   conv_thr         = 1e-08
   mixing_beta      = 0.3
/
