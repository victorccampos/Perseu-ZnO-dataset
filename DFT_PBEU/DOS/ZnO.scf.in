&control
  calculation = 'scf',
  pseudo_dir = '/home/jvc/QEspresso7.2/ZnO_database/pseudos',
  outdir='./dump_data',
  prefix = 'ZnO_PBEplusU',
  tprnfor=.true.
/
&system
  ibrav= 4,
  celldm(1) = 6.174600000 ! zno_vcrelax_hubbard_8.50_8.50.out
  celldm(3) = 1.599600000 ! zno_vcrelax_hubbard_8.50_8.50.out
  ntyp= 2,
  nat= 4,
  ecutwfc = 50,
  ecutrho = 400,
  occupations = 'fixed',
  nbnd = 36 
  ! nbnb = (2 átomos de Zn * 6 valencia) + (2 átomos de O * 4 valencia) 
/
&electrons
  conv_thr= 1.0d-8,
  mixing_beta=0.3,
/
