&CONTROL
   calculation      = 'vc-relax'
   nstep            = 450,
   verbosity        = 'high'
   outdir           = './'
   prefix           = 'ZnO-hubbard'
   disk_io          = 'none'
   pseudo_dir       = '/home/jvc/QEspresso7.2/ZnO_database/pseudos',
   tstress=.true.,
   tprnfor=.true.,
   forc_conv_thr=1.0d-6,
   etot_conv_thr=1.0d-6
/
&SYSTEM
   ibrav            = 4
   celldm(1)        = 6.178821408099
   celldm(3)        = 1.614358356153
   ecutwfc          = 50
   ecutrho          = 400
   occupations      = 'fixed'
   ntyp             = 2
   nat              = 4
/
&ELECTRONS
   diagonalization = 'david'
    mixing_mode='local-TF',
    conv_thr= 1.0d-9,
    mixing_beta=0.1,
    electron_maxstep=190,
/
&IONS
   ion_dynamics = 'bfgs'
/   
&CELL
cell_dynamics = 'bfgs',
  press_conv_thr  = 0.5d0,
  cell_dofree='ibrav'
/
ATOMIC_SPECIES
Zn 65.38 Zn.upf
O 15.999 O.upf

K_POINTS automatic
12 12 10 0 0 0

ATOMIC_POSITIONS crystal
Zn 0.6666666667 0.3333333333 0.5006335854  
Zn 0.3333333333 0.6666666667 0.0006335854  
O 0.6666666667 0.3333333333 0.8796764146  
O 0.3333333333 0.6666666667 0.3796764146  

HUBBARD (ortho-atomic)
U Zn-3d 12.0
U O-2p 8.0
