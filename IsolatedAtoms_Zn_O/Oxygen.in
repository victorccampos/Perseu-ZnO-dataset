&control
    calculation = 'scf',
    prefix = 'O_atom',
    pseudo_dir = '/home/jvc/QEspresso7.2/ZnO_database/pseudos'
    outdir = './'
/
&system
    ibrav = 1,
    celldm(1) = 30.0,    ! caixa cúbica com aresta = celldm(1)*a0 ≈ 30 a0 ~ 15.9 Å
    nat = 1,
    ntyp = 1,
    ecutwfc = 50,      
    ecutrho = 400,     
    occupations = 'fixed',
/
&electrons
    conv_thr = 1.0d-8,
    mixing_beta = 0.3,
/
ATOMIC_SPECIES
 O  15.999  O.upf

ATOMIC_POSITIONS angstrom
 O  0.0 0.0 0.0

K_POINTS {gamma}
