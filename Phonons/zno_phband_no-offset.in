&general
  PREFIX = ZnO222
  MODE   = phonons
  FCSXML = ZnO222.xml

  NKD = 2; KD = Zn O
  MASS = 65.38 15.999
/

&cell # (2x2x2 cell => a = 3.27*2/0.522 ~ 12.357)
  12.357 # factor in Bohr unit 
  1.0 0.0 0.0         # a1
  -0.5 0.866025 0.0   # a2
  0.0 0.0 1.6114      # a3
/

&kpoint # G -> K -> M -> G -> A
  1  # KPMODE = 1: line mode
  G 0.0 0.0 0.0 K 0.33 0.33 0.00 101
  K 0.33 0.33 0.00 M 0.50 0.00 0.00 101
  M 0.50 0.00 0.00 G 0.0 0.0 0.0 101
  G 0.0 0.0 0.0 A 0.0 0.00 0.50 101
/