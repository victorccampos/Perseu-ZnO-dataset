!Optimal Lattice Parameters (Bohr):
!	Lattice Parameter a = 6.1003
!	Lattice Parameter c = 9.8520
!	Ratio c/a = 1.6150
&CONTROL
  calculation = 'scf',
  pseudo_dir = '../pseudos_PBE_Opium',
  outdir='.'
  prefix = 'ZnO_opium',
  verbosity = 'high',
  tstress=.true.,
  tprnfor=.true.,
  disk_io = 'none'
/
&SYSTEM
    ibrav= 4,
    celldm(1) = 12.2006,
    celldm(3) = 1.6150,
    ntyp= 2
    nat=  32,
    ecutwfc =  70,
    ecutrho = 350,
    occupations = 'fixed',
    degauss = 0.005,
    smearing = 'gaussian',
/
&ELECTRONS
    diagonalization = 'david'
    mixing_mode='local-TF',
    conv_thr= 1.0d-9,
    mixing_beta=0.1,
    electron_maxstep=190,
/

