# Arquitetura: twist, 2 hidden layer(s), 12 node(s) por camada
# String de arquitetura: 12:twist 12:twist
# Sufixo dos arquivos ANN: 12tw-12tw

TRAININGSET ZnO_LDA.train
TESTPERCENT 10
ITERATIONS 1000

METHOD
bfgs

NETWORKS
! atom   network-file-name     hidden-layers   nodes:activation
Zn       Zn.25tw-25tw.ann      2        25:twist 25:twist
O        O.25tw-25tw.ann       2        25:twist 25:twist
