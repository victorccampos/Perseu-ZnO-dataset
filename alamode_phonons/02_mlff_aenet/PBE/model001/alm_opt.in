# Suggestion of displacement patterns of ZnO.
# Supercell size = 2 2 2 
# Lattice Parameter a = 12.357 Bohr = 6.53938 angstrom = 2 * 3.26969

&general
  PREFIX = ZnO222
  MODE = optimize
  NAT = 32; NKD = 2
  KD =  O Zn
/
&optimize
    DFSET = DFSET_harmonic
/
&interaction
  NORDER = 1  # 1: harmonic, 2: cubic, ..
/

&cell # (2x2x2 cell => a = 3.27*2/0.522 ~ 12.357)
  12.357 # factor in Bohr unit 
  1.0 0.0 0.0         # a1
  -0.5 0.866025 0.0   # a2
  0.0 0.0 1.6114      # a3
/

&cutoff 
  Zn-Zn None
  O-O None
  Zn-O None
/
