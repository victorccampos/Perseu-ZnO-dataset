units           metal
atom_style      atomic
boundary        p p p

read_data       tmp.lammps

mass 1 15.999
mass 2 65.380

pair_style      aenet O.10t-10t.ann-07890 Zn.10t-10t.ann-07890
pair_coeff      * *

dump            1 all custom 1 XFSET id xu yu zu fx fy fz
dump_modify     1 format float "%20.15f"
run             0
