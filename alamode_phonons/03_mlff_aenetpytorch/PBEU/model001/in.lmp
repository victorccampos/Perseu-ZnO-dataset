units           metal
atom_style      atomic
boundary        p p p

read_data       tmp.lammps

mass 1 65.380
mass 2 15.999


pair_style      aenet Zn.pytorch.nn O.pytorch.nn
pair_coeff      * *

dump            1 all custom 1 XFSET id xu yu zu fx fy fz
dump_modify     1 format float "%20.15f"
run             0
