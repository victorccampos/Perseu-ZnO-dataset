# Figure Layout

figure.figsize      : 6, 5
figure.facecolor    : white
figure.dpi          : 150
savefig.dpi         : 600
figure.autolayout   : True

# Fonts & Text - Computer Modern LaTeX

font.family         : serif
font.serif          : DejaVu Serif, Times New Roman, serif
font.size           : 14
text.color          : black
axes.titlesize      : 16
axes.labelsize      : 16
axes.labelpad       : 10
xtick.labelsize     : 14
ytick.labelsize     : 14
mathtext.fontset    : cm

# Axes & Spines
axes.facecolor      : "FDFBF0" # The distinct cream background color
axes.edgecolor      : black
axes.linewidth      : 1.5
axes.spines.top     : True
axes.spines.right   : True
axes.spines.bottom  : True
axes.spines.left    : True

# Ticks 
xtick.direction     : in
ytick.direction     : in
xtick.major.size    : 6
ytick.major.size    : 6
xtick.minor.size    : 3
ytick.minor.size    : 3
xtick.major.width   : 1.0
ytick.major.width   : 1.0
xtick.minor.visible : True
ytick.minor.visible : True
xtick.top           : True
ytick.right         : True
xtick.major.pad     : 10
xtick.minor.pad     : 10
ytick.major.pad     : 10
ytick.minor.pad     : 10

# Grid
# Dotted black grid lines
axes.grid           : False
axes.grid.axis      : both
grid.color          : lightgray
grid.linestyle      : :
grid.linewidth      : 1.0
grid.alpha          : 1.0

# Lines & Colors
# axes.prop_cycle   : cycler('color', ['000000', '483D8B', '2E2E2E', '555555'])
lines.linewidth     : 2.0
lines.solid_capstyle: round

# Legend
legend.frameon      : False
legend.fontsize     : 12
