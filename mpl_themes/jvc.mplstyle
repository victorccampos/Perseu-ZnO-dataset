# Figure Layout
figure.figsize: 5, 4.5
figure.facecolor: white
figure.dpi: 150
figure.autolayout: True

# Fonts & Text
# Uses Computer Modern for math to mimic the LaTeX look in the image
font.family: serif
font.serif: DejaVu Serif, Times New Roman, serif
font.size: 14
text.color: black
axes.titlesize: 16
axes.labelsize: 16
axes.labelpad: 10
xtick.labelsize: 14
ytick.labelsize: 14
mathtext.fontset: cm

# Axes & Spines
# The distinct cream background color
axes.facecolor: "FDFBF0" # FDFBF0 bege
axes.edgecolor: black
axes.linewidth: 1.5
axes.spines.top: True
axes.spines.right: True
axes.spines.bottom: True
axes.spines.left: True

# Ticks
# Ticks point inward on all sides
xtick.direction: in
ytick.direction: in
xtick.major.size: 6
ytick.major.size: 6
xtick.minor.size: 3
ytick.minor.size: 3
xtick.major.width: 1.0
ytick.major.width: 1.0
xtick.minor.visible: True
ytick.minor.visible: True
xtick.top: True
ytick.right: True
xtick.major.pad      : 10
xtick.minor.pad      : 10
ytick.major.pad      : 10
ytick.minor.pad      : 10

# Grid
# Dotted black grid lines
axes.grid: True
axes.grid.axis: both
grid.color: lightgray
grid.linestyle: :
grid.linewidth: 1.0
grid.alpha: 1.0

# Lines & Colors
# default cycle mimicking the black and purple/blue in the image
# axes.prop_cycle: cycler('color', ['000000', '483D8B', '2E2E2E', '555555'])
lines.linewidth: 2.0
lines.solid_capstyle: round

# Legend
legend.frameon: False
legend.fontsize: 12
