LAMMPS (4 Feb 2020)
# --------------- INITIALIZATION ----------------------
units           metal
atom_style      atomic
boundary        p p p

# --------------- ATOM DEFINITION --------------------
read_data       ZnO-444.lammps
  triclinic box = (0 0 0) to (12.7847 11.0719 20.5258) with tilt (-6.39236 0 0)
  2 by 3 by 4 MPI processor grid
  reading atoms ...
  256 atoms
  read_data CPU = 0.00498445 secs

mass 1 65.380 # Zn = 1
mass 2 15.999 # O  = 2

# ----------------- Force Fields ----------------------
pair_style      aenet Zn.pytorch.nn O.pytorch.nn
pair_coeff      * *

# ----------------- VARIABLES ----------------------
variable P_target equal 0
variable T_target equal 100
variable material string ZnO


# ================= EQUILIBRATION =====================
# Set timestep to 1 fs (10^-15s) ||  [time] = picoseconds
timestep        0.001
# Set temperature
velocity    all create ${T_target} 13282209 dist gaussian
velocity    all create 100 13282209 dist gaussian
# Assign fixes --- NPT simulation T_i = T_target =T_f
# iso = same pressure in all directions (isotropic)
#
fix         1 all npt temp ${T_target} ${T_target} 0.1 iso ${P_target} ${P_target} 1.0
fix         1 all npt temp 100 ${T_target} 0.1 iso ${P_target} ${P_target} 1.0
fix         1 all npt temp 100 100 0.1 iso ${P_target} ${P_target} 1.0
fix         1 all npt temp 100 100 0.1 iso 0 ${P_target} 1.0
fix         1 all npt temp 100 100 0.1 iso 0 0 1.0


# Set thermo output
thermo          200
thermo_style    custom step temp press vol ke pe etotal

# --- Produção ---

# 1. Equilíbrio (Termalização) (ex: 50 ps)
run             2000
Neighbor list info ...
  update every 1 steps, delay 10 steps, check yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 10
  ghost atom cutoff = 10
  binsize = 5, bins = 4 3 5
  1 neighbor lists, perpetual/occasional/extra = 1 0 0
  (1) pair aenet, perpetual
      attributes: full, newton on
      pair build: full/bin/atomonly
      stencil: full/bin/3d
      bin: standard
