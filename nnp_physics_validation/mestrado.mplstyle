# =====================================================
# MLFF / Scientific Publication Style
# =====================================================

# ---------------- Figure -----------------------------

figure.dpi : 300
savefig.dpi : 300

figure.facecolor : "#F4F4F4"


#figure.constrained_layout.use : True
figure.autolayout   : True
# ---------------- Fonts ------------------------------

font.family         : serif
font.serif          : DejaVu Serif
mathtext.fontset : dejavusans

font.size : 10

# ---------------- Titles -----------------------------

figure.titlesize : 16

axes.titlesize : 14
axes.labelsize : 12

# ---------------- Axes -------------------------------

axes.linewidth : 1.25
axes.facecolor      : "#FDFBF0"
axes.grid : True

# ---------------- Grid -------------------------------

grid.color : dimgrey
grid.linestyle : --
grid.alpha : 0.4
grid.linewidth : 0.8

# ---------------- Ticks ------------------------------

xtick.top : False
ytick.right : False

xtick.direction : inout
ytick.direction : inout

xtick.labelsize : 10                                   
ytick.labelsize : 10

xtick.major.size : 4.375
ytick.major.size : 4.375

xtick.minor.size : 2.5
ytick.minor.size : 2.5

xtick.major.width : 1.0
ytick.major.width : 1.0

xtick.minor.width : 0.75
ytick.minor.width : 0.75

xtick.minor.visible : True
ytick.minor.visible : True

xtick.major.pad : 5
ytick.major.pad : 5

# ---------------- Lines ------------------------------

lines.linewidth : 1.5
lines.markersize : 5

# ---------------- Legend -----------------------------

legend.fontsize : 10

# ---------------- Saving -----------------------------

savefig.bbox : tight
savefig.pad_inches : 0.02

# ---------------- Color Cycle ------------------------

axes.prop_cycle : cycler('color', ['1f77b4', 'ff7f0e', '2ca02c', 'd62728', '9467bd', '8c564b','e377c2', '7f7f7f', 'bcbd22','17becf'])
