LAMMPS (4 Feb 2020)
# --------------- INITIALIZATION ----------------------
units           metal
atom_style      atomic
boundary        p p p

# --------------- ATOM DEFINITION --------------------
read_data       ZnO-444.lammps
  triclinic box = (0 0 0) to (12.7847 11.0719 20.5258) with tilt (-6.39236 0 0)
  2 by 4 by 4 MPI processor grid
  reading atoms ...
  256 atoms
  read_data CPU = 0.00540764 secs

mass 1 65.380 # Zn = 1
mass 2 15.999 # O  = 2

# ----------------- Force Fields ----------------------
variable pot_dir string "../../potentials/model009"
pair_style      aenet ${pot_dir}/Zn.aenetpy.ann ${pot_dir}/O.aenetpy.ann
pair_style      aenet ../../potentials/model009/Zn.aenetpy.ann ${pot_dir}/O.aenetpy.ann
pair_style      aenet ../../potentials/model009/Zn.aenetpy.ann ../../potentials/model009/O.aenetpy.ann
pair_coeff      * *

# ----------------- VARIABLES ----------------------
variable P_target equal 0
variable T_target equal 100
variable material string ZnO


# ================= EQUILIBRATION =====================
# Set timestep to 1 fs (10^-15s) [time] = picoseconds

timestep        0.001

# Set temperature
velocity    all create ${T_target} 13282209 dist gaussian
velocity    all create 100 13282209 dist gaussian

# Assign fixes --- NPT simulation
# T_i = T_target = T_f
# iso = same pressure in all directions (isotropic)

fix         1 all npt temp ${T_target} ${T_target} 0.1 iso ${P_target} ${P_target} 1.0
fix         1 all npt temp 100 ${T_target} 0.1 iso ${P_target} ${P_target} 1.0
fix         1 all npt temp 100 100 0.1 iso ${P_target} ${P_target} 1.0
fix         1 all npt temp 100 100 0.1 iso 0 ${P_target} 1.0
fix         1 all npt temp 100 100 0.1 iso 0 0 1.0


# Set thermo output
thermo          100
thermo_style    custom step temp press vol ke pe etotal

# --- Produção ---
# 1. Equilíbrio (Termalização) (ex: 200 000 -> 200ps - 0.2 ns)

run             400000
