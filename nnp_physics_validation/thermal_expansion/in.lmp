# ----------------- VARIABLES ----------------------
variable P_target equal 0
variable T_target equal TEMP_PLACEHOLDER
variable material string ZnO
variable pot_dir string "../../potentials/model009"

# --------------- INITIALIZATION ----------------------
units           metal
atom_style      atomic
boundary        p p p

# --------------- ATOM DEFINITION --------------------
read_data       ZnO-444.lammps

mass 1 65.380 # Zn = 1
mass 2 15.999 # O  = 2

# ----------------- Force Fields ----------------------
pair_style      aenet ${pot_dir}/Zn.aenetpy.ann ${pot_dir}/O.aenetpy.ann
pair_coeff      * *



# ================= EQUILIBRATION =====================
# Set timestep to 1 fs (10^-15s) [time] = picoseconds	

timestep        0.001 

# Set temperature
velocity    all create ${T_target} 13282209 dist gaussian

# Assign fixes --- NPT simulation
# T_i = T_target = T_f
# iso = same pressure in all directions (isotropic)

fix         1 all npt temp ${T_target} ${T_target} 0.1 iso ${P_target} ${P_target} 1.0


# Set thermo output
thermo          100
thermo_style    custom step temp press vol ke pe etotal

# --- Produção ---
# 1. Equilíbrio (Termalização) (ex: 200 000 -> 200ps - 0.2 ns)

run             100

# 2. Produção -- cálculo de média (ex: 50 ps)
#fix             2 all ave/time 10 100 1000 v_vol file volume_vs_time_${T_target}.dat
#run             100000

