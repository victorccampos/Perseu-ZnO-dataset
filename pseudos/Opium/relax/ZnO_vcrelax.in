&CONTROL
  calculation = 'vc-relax',
  restart_mode = 'from_scratch',
  pseudo_dir = '../pseudos_PBE_Opium',
  prefix = 'ZnO_opium_vcrelax',
  nstep=450,
  verbosity = 'high',
  tstress=.true.,
  tprnfor=.true.,
  forc_conv_thr=1.0d-5,
  etot_conv_thr=1.0d-6,
/
&SYSTEM
    ibrav= 4,
    celldm(1) = 6.10,
    celldm(3) = 1.6,
    ntyp= 2
    nat=  4,
    ecutwfc =  70,
    ecutrho = 350,
    occupations = 'fixed',
    nbnd =  36,
    degauss = 0.005,
    smearing = 'gaussian',
/
&ELECTRONS
    diagonalization = 'david'
    mixing_mode='local-TF',
    conv_thr= 1.0d-9,
    mixing_beta=0.1,
    electron_maxstep=190,
/

/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
  press_conv_thr  = 0.5d0,
  cell_dofree='ibrav'
/

ATOMIC_SPECIES
Zn   65.380    Zn.upf
 O   15.999    O.upf

K_POINTS automatic
 12 12 10  0  0  0

ATOMIC_POSITIONS (crystal)
 Zn   0.6666666666666661    0.3333333333333330    0.5005917000000000
 Zn   0.3333333333333330    0.6666666666666661    0.0005916999999990
  O   0.6666666666666661    0.3333333333333330    0.8797183000000000
  O   0.3333333333333330    0.6666666666666661    0.3797182999999990
